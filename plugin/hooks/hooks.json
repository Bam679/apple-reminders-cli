{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v apple-reminders >/dev/null 2>&1 || exit 0; exec apple-reminders guard",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
